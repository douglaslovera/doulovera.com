---
import { getCollection } from "astro:content";
import PocsLayout from "../../layouts/PocsLayout.astro";

const posts = (await getCollection("pocs")).sort(
  (a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime()
);
const dateFormatter = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC"
});
---

<PocsLayout title="POCs | Douglas Lovera" description="Notes from Douglas Lovera's experiments, ideas, and experiences.">
  <main class="relative mx-auto w-full max-w-290 px-4 pb-24 pt-12 md:pt-20">
    <div class="mb-12 max-w-170">
      <p class="mb-4 font-(--accent-font) text-xs uppercase tracking-[0.22em] text-(--mint)">/pocs</p>
      <h1 class="font-(--display-font) text-[clamp(3.5rem,10vw,7rem)] font-bold uppercase leading-[0.9] tracking-[-0.035em] text-(--chrome)">Proof of concepts</h1>
      <p class="mt-6 max-w-145 text-lg text-(--muted)">Notes from ideas I tried, things I built, and what I found along the way.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {posts.map((post) => (
        <article class="group min-h-64 overflow-hidden rounded-[2rem] border border-white/10 bg-(--panel) shadow-(--shadow) transition hover:border-(--line-strong)">
          <a href={`/pocs/${post.id}`} class="flex h-full flex-col focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--mint)">
            {post.data.thumbnail && (
              <img src={post.data.thumbnail} alt="" width="1200" height="630" class="aspect-[1200/630] w-full object-cover" />
            )}
            <div class="flex flex-1 flex-col p-6 md:p-8">
              <time datetime={post.data.createdAt.toISOString()} class="font-(--accent-font) text-xs uppercase tracking-[0.12em] text-(--mint)">{dateFormatter.format(post.data.createdAt)}</time>
              <h2 class="mt-3 font-(--display-font) text-3xl font-bold uppercase leading-tight text-(--chrome) transition group-hover:text-(--mint)">{post.data.title}</h2>
              <span class="mt-auto pt-6 font-(--accent-font) text-xs uppercase tracking-[0.1em] text-(--muted)">Read post ↗</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </main>
</PocsLayout>
