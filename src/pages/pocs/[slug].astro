---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PocsLayout from "../../layouts/PocsLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("pocs");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

interface Props {
  post: CollectionEntry<"pocs">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFormatter = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC"
});
---

<PocsLayout title={`${post.data.title} | Douglas Lovera`} description={`${post.data.title}, a proof of concept by Douglas Lovera.`}>
  <main class="relative mx-auto w-full max-w-220 px-4 pb-24 pt-10 md:pt-16">
    <a href="/pocs" class="font-(--accent-font) text-xs uppercase tracking-[0.1em] text-(--mint) transition hover:text-(--chrome)">← All POCs</a>
    <article class="mt-10">
      <header class="mb-10">
        <time datetime={post.data.createdAt.toISOString()} class="font-(--accent-font) text-xs uppercase tracking-[0.12em] text-(--muted)">{dateFormatter.format(post.data.createdAt)}</time>
        <h1 class="mt-4 font-(--display-font) text-[clamp(3rem,8vw,5.5rem)] font-bold uppercase leading-[0.95] tracking-[-0.025em] text-(--chrome)">{post.data.title}</h1>
      </header>
      {post.data.thumbnail && (
        <img src={post.data.thumbnail} alt="" width="1200" height="630" class="mb-12 aspect-[1200/630] w-full rounded-[2rem] border border-white/10 object-cover" />
      )}
      <div class="poc-content max-w-180 text-(--text)">
        <Content />
      </div>
    </article>
  </main>
</PocsLayout>
