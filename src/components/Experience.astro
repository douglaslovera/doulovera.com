---
interface ExperienceItem {
  company: string;
  role: string;
  time: string;
  description: string;
}

interface Props {
  title: string;
  experiences: ExperienceItem[];
}

const { title, experiences } = Astro.props;
---

<section id="experience" class="py-20 md:py-32 scroll-mt-24">
  <h2 class="text-5xl md:text-7xl font-black italic tracking-tighter mb-16 inline-block bg-white text-black px-6 py-2 rotate-[1deg] border-4 border-black">
    {title}
  </h2>

  <div class="space-y-16">
    {
      experiences.map((exp, index) => (
        <div class={`flex flex-col md:flex-row gap-8 md:gap-16 border-t-2 border-white/20 pt-12 ${index % 2 === 0 ? "animate-fade-in delay-100" : "animate-fade-in delay-200"}`}>
          <div class="md:w-1/3 space-y-2">
            <h3 class="text-3xl font-black italic tracking-tighter text-primary">
              {exp.company}
            </h3>
            <p class="text-xl font-bold text-white/80">
              {exp.role}
            </p>
            <p class="text-sm font-black uppercase tracking-widest text-white/50">
              {exp.time}
            </p>
          </div>
          <div class="md:w-2/3">
            <p class="text-lg md:text-xl text-white/70 leading-relaxed font-medium">
              {exp.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
