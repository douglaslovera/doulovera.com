---
import Button from "./Button.astro";
import SectionTitle from "./SectionTitle.astro";
import type { Translations } from "../i18n";

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section class="section" id="projects">
  <div class="container">
    <SectionTitle label={t.projects.title} number="02" />

    <div class="projects-list">
      {
        t.projects.items.map((project, i) => (
          <article class={`project-card brutal-card reveal ${i % 2 !== 0 ? "project-card--reverse" : ""}`} style={`animation-delay: ${i * 0.15}s`}>
            <!-- Image -->
            <div class="project-image-wrap">
              <div class="project-number">
                <span>{String(i + 1).padStart(2, "0")}</span>
              </div>
              <img
                src={project.image}
                alt={project.title}
                class="project-image"
                loading="lazy"
              />
              <div class="image-overlay" />
            </div>

            <!-- Content -->
            <div class="project-content">
              <h3 class="project-title">{project.title}</h3>

              <p class="project-description">{project.description}</p>

              <div class="project-tags">
                {project.technologies.map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
              </div>

              <div class="project-links">
                {project.github && (
                  <Button href={project.github} variant="outline" target="_blank" rel="noopener noreferrer">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    {t.projects.githubBtn}
                  </Button>
                )}
                {project.preview && (
                  <Button href={project.preview} variant="primary" target="_blank" rel="noopener noreferrer">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                      <polyline points="15,3 21,3 21,9"/>
                      <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                    {t.projects.previewBtn}
                  </Button>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .project-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 380px;
    overflow: hidden;
    position: relative;
  }

  .project-card--reverse {
    direction: rtl;
  }

  .project-card--reverse > * {
    direction: ltr;
  }

  /* ── Image ── */
  .project-image-wrap {
    position: relative;
    overflow: hidden;
  }

  .project-number {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 800;
    color: var(--accent);
    opacity: 0.6;
    line-height: 1;
    pointer-events: none;
  }

  .project-card--reverse .project-number {
    left: auto;
    right: 1.5rem;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), filter 0.3s;
    filter: grayscale(30%);
  }

  .project-card:hover .project-image {
    transform: scale(1.04);
    filter: grayscale(0%);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent 60%,
      var(--bg-card) 100%
    );
    pointer-events: none;
  }

  .project-card--reverse .image-overlay {
    background: linear-gradient(
      to left,
      transparent 60%,
      var(--bg-card) 100%
    );
  }

  /* ── Content ── */
  .project-content {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
  }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.1;
    margin: 0;
  }

  .project-description {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.8;
    margin: 0;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .project-card {
      grid-template-columns: 1fr;
      direction: ltr;
    }

    .project-card--reverse {
      direction: ltr;
    }

    .project-image-wrap {
      height: 220px;
    }

    .image-overlay {
      background: linear-gradient(
        to bottom,
        transparent 60%,
        var(--bg-card) 100%
      );
    }

    .project-card--reverse .image-overlay {
      background: linear-gradient(
        to bottom,
        transparent 60%,
        var(--bg-card) 100%
      );
    }

    .project-content {
      padding: 1.5rem;
    }
  }
</style>
