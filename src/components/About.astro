---
import SectionTitle from "./SectionTitle.astro";
import type { Translations } from "../i18n";

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section class="section" id="about">
  <div class="container">
    <div class="about-inner">
      <!-- Left: text -->
      <div class="about-text">
        <SectionTitle label={t.about.title} number="04" />

        <div class="about-paragraphs">
          {
            t.about.paragraphs.map((paragraph, i) => (
              <p
                class={`about-paragraph reveal`}
                style={`transition-delay: ${i * 0.15}s`}
              >
                {paragraph}
              </p>
            ))
          }
        </div>

        <div class="about-skills reveal delay-400">
          <p class="skills-label">// tech I work with</p>
          <div class="skills-grid">
            {
              [
                "TypeScript",
                "React",
                "Astro",
                "Vue",
                "Tailwind CSS",
                "Node.js",
                "Git",
                "Figma",
              ].map((skill) => (
                <span class="skill-item">
                  <span class="skill-arrow">▸</span> {skill}
                </span>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Right: photo -->
      <div class="about-photo reveal delay-200">
        <div class="img-frame">
          <img
            src="/assets/douglas-bg.jpg"
            alt="Douglas Lovera"
            class="about-img"
            loading="lazy"
          />
        </div>

        <div class="about-photo-caption">
          <span class="caption-line">
            <span class="accent-dot">◆</span>
            Frontend Developer
          </span>
          <span class="caption-line">
            <span class="accent-dot">◆</span>
            UI Engineer
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 5rem;
    align-items: start;
  }

  /* ── Text ── */
  .about-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .about-paragraph {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.9;
    margin: 0;
  }

  .about-paragraph:first-child {
    font-size: 15px;
    color: var(--text-primary);
  }

  /* ── Skills ── */
  .skills-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.05em;
    margin: 0 0 1rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 2rem;
  }

  .skill-item {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .skill-arrow {
    color: var(--accent);
    font-size: 10px;
  }

  /* ── Photo ── */
  .about-photo {
    position: sticky;
    top: 90px;
  }

  .about-img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
    display: block;
    filter: grayscale(15%);
    transition: filter 0.3s;
  }

  .about-img:hover {
    filter: grayscale(0%);
  }

  .about-photo-caption {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .caption-line {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .accent-dot {
    color: var(--accent);
    font-size: 8px;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .about-photo {
      position: static;
      max-width: 360px;
    }
  }
</style>
