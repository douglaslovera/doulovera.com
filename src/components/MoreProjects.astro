---
import SectionTitle from "./SectionTitle.astro";
import type { Translations } from "../i18n";

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section class="section" id="more-projects">
  <div class="container">
    <SectionTitle label={t.moreProjects.title} number="03" />

    <div class="more-grid">
      {
        t.moreProjects.items.map((project, i) => (
          <article
            class="more-card brutal-card reveal"
            style={`animation-delay: ${i * 0.1}s`}
          >
            <div class="more-card-top">
              <div class="more-card-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polyline points="16,18 22,12 16,6"/>
                  <polyline points="8,6 2,12 8,18"/>
                </svg>
              </div>
              <div class="more-card-links">
                {project.github && (
                  <a
                    href={project.github}
                    class="icon-link"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${t.moreProjects.githubBtn} — ${project.title}`}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                  </a>
                )}
                {project.preview && (
                  <a
                    href={project.preview}
                    class="icon-link"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${t.moreProjects.previewBtn} — ${project.title}`}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                      <polyline points="15,3 21,3 21,9"/>
                      <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>

            <h3 class="more-card-title">{project.title}</h3>

            <div class="more-card-tags">
              {project.technologies.map((tech) => (
                <span class="tag">{tech}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .more-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1px;
    border: 1px solid var(--border);
  }

  .more-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: none;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transition:
      background 0.15s,
      transform 0.15s,
      box-shadow 0.15s,
      border-color 0.15s;
  }

  /* Override brutal-card hover to work within grid */
  .more-card:hover {
    background: var(--bg-elevated);
    border-color: var(--border-accent);
    box-shadow: none;
    transform: none;
    z-index: 1;
    outline: 1px solid var(--border-accent);
  }

  .more-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .more-card-icon {
    color: var(--accent);
    opacity: 0.7;
  }

  .more-card-links {
    display: flex;
    gap: 0.5rem;
  }

  .icon-link {
    color: var(--text-muted);
    transition: color 0.15s, transform 0.15s;
    display: flex;
    align-items: center;
  }

  .icon-link:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  .more-card-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
    transition: color 0.15s;
  }

  .more-card:hover .more-card-title {
    color: var(--accent);
  }

  .more-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }

  @media (max-width: 480px) {
    .more-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
