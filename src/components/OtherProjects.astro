---
interface OtherProjectItem {
  title: string;
  technologies: string[];
  github?: string;
  preview?: string;
}

interface Props {
  title: string;
  projects: OtherProjectItem[];
}

const { title, projects } = Astro.props;
---

<section class="py-20 md:py-32 scroll-mt-24">
  <h2 class="text-4xl md:text-6xl font-black italic tracking-tighter mb-16 inline-block bg-primary text-black px-6 py-2 rotate-[-1deg] border-4 border-black uppercase">
    {title}
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      projects.map((proj) => (
        <div class="brutal-card group animate-fade-in delay-100 hover:translate-x-[-4px] hover:translate-y-[-4px] transition-all hover:shadow-[12px_12px_0px_0px_white]">
          <div class="flex flex-col h-full justify-between gap-6">
            <div class="space-y-4">
              <h3 class="text-2xl font-black italic tracking-tighter text-primary group-hover:text-white transition-colors">
                {proj.title}
              </h3>
              <div class="flex flex-wrap gap-2">
                {
                  proj.technologies.map((tech) => (
                    <span class="text-[10px] font-black uppercase tracking-widest border-2 border-white/30 px-2 py-0.5 text-white/50 group-hover:border-white/70 group-hover:text-white/80 transition-colors">
                      {tech}
                    </span>
                  ))
                }
              </div>
            </div>

            <div class="flex gap-4 border-t-2 border-white/10 pt-4">
              {
                proj.github && (
                  <a href={proj.github} class="text-sm font-black uppercase tracking-widest hover:text-primary transition-colors">
                    GitHub
                  </a>
                )
              }
              {
                proj.preview && (
                  <a href={proj.preview} class="text-sm font-black uppercase tracking-widest hover:text-primary transition-colors">
                    Preview
                  </a>
                )
              }
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
