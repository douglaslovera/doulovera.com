---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { label: t("hero.resume"), href: "/cv.pdf" },
  { label: t("hero.github"), href: "https://github.com" },
  { label: t("hero.linkedin"), href: "https://linkedin.com" },
];
---

<footer class="py-20 border-t-2 border-white/10 mt-20">
  <div class="max-w-7xl mx-auto px-6 md:px-12 flex flex-col md:flex-row justify-between items-center gap-12">
    <div class="text-3xl font-black italic tracking-tighter">
      DL.
    </div>

    <div class="flex gap-8 font-black uppercase tracking-widest text-sm">
      {
        links.map((link) => (
          <a href={link.href} class="hover:text-primary transition-colors hover:underline underline-offset-8 decoration-4">
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="text-xs font-black uppercase tracking-[0.2em] text-white/30">
      © {new Date().getFullYear()} — {t("footer.rights")}
    </div>
  </div>
</footer>
