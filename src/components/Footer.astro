---
import type { Translations } from "../i18n";

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-credit">
      {t.footer.credit}
      <span class="footer-year">— {year}</span>
    </p>

    <nav class="footer-nav">
      <a href="/resume.pdf" class="footer-link" target="_blank" rel="noopener">
        {t.footer.resumeBtn}
        <span class="link-arrow">↗</span>
      </a>
      <span class="footer-sep">·</span>
      <a
        href="https://github.com/doulovera"
        class="footer-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.footer.githubBtn}
        <span class="link-arrow">↗</span>
      </a>
      <span class="footer-sep">·</span>
      <a
        href="https://linkedin.com/in/doulovera"
        class="footer-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.footer.linkedinBtn}
        <span class="link-arrow">↗</span>
      </a>
    </nav>
  </div>

  <!-- Bottom accent line -->
  <div class="footer-accent"></div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: 70px;
  }

  .footer-credit {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    margin: 0;
    letter-spacing: 0.05em;
  }

  .footer-year {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-link {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .footer-link:hover {
    color: var(--accent);
  }

  .link-arrow {
    font-size: 10px;
    opacity: 0;
    transition:
      opacity 0.15s,
      transform 0.15s;
    transform: translate(-2px, 2px);
  }

  .footer-link:hover .link-arrow {
    opacity: 1;
    transform: translate(0px, 0px);
  }

  .footer-sep {
    color: var(--border);
  }

  /* Bottom accent stripe */
  .footer-accent {
    height: 3px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent) 20%,
      var(--accent) 50%,
      transparent
    );
    opacity: 0.5;
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      height: auto;
      padding: 1.5rem 0;
      gap: 1rem;
    }
  }
</style>
