---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  title: string;
  description: string;
  image: string;
  technologies: string[];
  github?: string;
  preview?: string;
}

const { title, description, image, technologies, github, preview } = Astro.props;
---

<div class="flex flex-col md:flex-row gap-12 group animate-fade-in py-16 border-b-2 border-white/10 last:border-0">
  <div class="md:w-1/2 relative group">
    <div class="absolute inset-0 bg-primary translate-x-4 translate-y-4 border-2 border-white group-hover:translate-x-2 group-hover:translate-y-2 transition-transform duration-300"></div>
    <div class="relative overflow-hidden border-4 border-white shadow-[8px_8px_0px_0px_white] aspect-video">
      <img 
        src={image} 
        alt={title}
        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105"
      />
    </div>
  </div>

  <div class="md:w-1/2 flex flex-col justify-center space-y-6">
    <div class="space-y-2">
      <h3 class="text-4xl md:text-5xl font-black italic tracking-tighter text-white group-hover:text-primary transition-colors">
        {title}
      </h3>
      <div class="flex flex-wrap gap-2 pt-2">
        {
          technologies.map((tech) => (
            <span class="text-xs font-black uppercase tracking-widest border-2 border-white/50 px-3 py-1 bg-white/5 text-white/70">
              {tech}
            </span>
          ))
        }
      </div>
    </div>

    <p class="text-xl text-white/70 font-medium leading-relaxed">
      {description}
    </p>

    <div class="flex gap-4 pt-4">
      {
        github && (
          <a 
            href={github} 
            class="brutal-btn bg-black text-white border-2 border-white hover:bg-white hover:text-black hover:border-black"
          >
            {t("projects.github")}
          </a>
        )
      }
      {
        preview && (
          <a 
            href={preview} 
            class="brutal-btn brutal-btn-primary"
          >
            {t("projects.preview")}
          </a>
        )
      }
    </div>
  </div>
</div>
