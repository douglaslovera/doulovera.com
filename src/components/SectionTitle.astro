---
interface Props {
  label: string;
  id?: string;
  number?: string;
}

const { label, id, number } = Astro.props;
---

<div class="section-title reveal" id={id}>
  {number && <span class="section-number">{number}</span>}
  <span class="accent-line"></span>
  <h2>{label}</h2>
</div>

<style>
  .section-title {
    margin-bottom: 3rem;
  }

  .section-number {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .accent-line {
    display: block;
    margin-bottom: 0.75rem;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1;
    color: var(--text-primary);
    margin: 0;
  }
</style>
