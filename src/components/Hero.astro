---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  name: string;
  role: string;
  description: string;
}

const { name, role, description } = Astro.props;
---

<section class="min-h-[80vh] flex flex-col md:flex-row items-center justify-between gap-12 py-10 md:py-20 animate-fade-in">
  <div class="flex-1 space-y-8">
    <div class="space-y-4">
      <h1 class="text-6xl md:text-8xl font-black italic tracking-tighter leading-none">
        {name}
      </h1>
      <p class="text-2xl md:text-3xl font-bold text-primary inline-block bg-primary text-black px-4 py-2 rotate-[-2deg] border-2 border-black">
        {role}
      </p>
    </div>
    
    <p class="text-xl md:text-2xl text-white/80 max-w-xl font-medium leading-relaxed">
      {description}
    </p>

    <div class="flex flex-wrap gap-4 pt-4">
      <a href="/cv.pdf" class="brutal-btn brutal-btn-primary">
        {t('hero.resume')}
      </a>
      <a href="https://github.com" class="brutal-btn bg-black text-white hover:bg-white hover:text-black">
        {t('hero.github')}
      </a>
      <a href="https://linkedin.com" class="brutal-btn bg-[#0077b5] border-[#0077b5] text-white hover:bg-white hover:text-[#0077b5]">
        {t('hero.linkedin')}
      </a>
    </div>
  </div>

  <div class="relative group">
    <div class="absolute inset-0 bg-primary rotate-6 border-3 border-white group-hover:rotate-3 transition-transform duration-300"></div>
    <div class="relative border-4 border-white overflow-hidden w-64 h-64 md:w-80 md:h-80 shadow-[10px_10px_0px_0px_white]">
      <img 
        src="/assets/douglas.webp" 
        alt={name}
        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 scale-105 group-hover:scale-100"
      />
    </div>
  </div>
</section>
