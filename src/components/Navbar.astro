---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { label: t("nav.experience"), href: "#experience" },
  { label: t("nav.projects"), href: "#projects" },
  { label: t("nav.about"), href: "#about" },
];

const langSwitcher = lang === "en" ? { label: "ES", href: "/es/" } : { label: "EN", href: "/" };
---

<header class="fixed top-0 left-0 w-full z-50 py-4 px-6 md:px-12 bg-[#0d0d0d]/80 backdrop-blur-sm border-b-2 border-white/10">
  <nav class="max-w-7xl mx-auto flex items-center justify-between">
    <a href={`/${lang === "en" ? "" : "es/"}`} class="text-2xl font-black italic tracking-tighter transition-all hover:text-primary">
      DL.
    </a>

    <div class="flex items-center gap-8 font-bold text-sm tracking-wide">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="hidden md:block hover:text-primary transition-all uppercase"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={langSwitcher.href}
        class="border-2 border-white px-3 py-1 hover:bg-white hover:text-black transition-all"
      >
        {langSwitcher.label}
      </a>
    </div>
  </nav>
</header>
